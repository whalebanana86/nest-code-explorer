{
  "name": "nest-code-explorer",
  "version": "0.3.0",
  "description": "Static code explorer for NestJS: interactive single-file HTML (structure + execution paths) and mermaid code map, generated from source with ts-morph",
  "keywords": [
    "nestjs",
    "code-explorer",
    "dependency-graph",
    "call-graph",
    "static-analysis",
    "ts-morph",
    "visualization",
    "architecture"
  ],
  "license": "MIT",
  "author": "whalebanana86",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whalebanana86/nest-code-explorer.git"
  },
  "homepage": "https://github.com/whalebanana86/nest-code-explorer#readme",
  "bugs": {
    "url": "https://github.com/whalebanana86/nest-code-explorer/issues"
  },
  "main": "dist/analyze.js",
  "bin": {
    "nest-code-explorer": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "template",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/fixture.test.js test/init.test.js test/example.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ts-morph": "^28.0.0",
    "vis-network": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^5.7.3"
  }
}
